+pub fn minimize(self: *Self) void {
+    if (self.minimized) return;
+
+    self.minimized_tag = self.tag;
+    self.minimized = true;
+    self.set_tag(0x80000000);
+
+    if (self.output) |output| {
+        const visible_tag = output.tag & 0x7fffffff;
+        output.set_tag(if (visible_tag == 0) 1 else visible_tag);
+    }
+}
+
+
+pub fn restore_minimized(self: *Self) void {
+    const restore_tag = if (self.output) |output|
+        if (output.tag == 0xffffffff) output.prev_tag else output.tag & 0x7fffffff
+    else
+        self.minimized_tag;
+    const target_tag = if (restore_tag == 0) self.minimized_tag else restore_tag;
+
+    self.minimized = false;
+    self.minimized_tag = 0;
+    self.set_tag(target_tag);
+    if (self.output) |output| output.set_tag(target_tag);
+}
+
