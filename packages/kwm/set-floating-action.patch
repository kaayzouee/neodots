+            .restore_minimized_window => {
+                // The Dock writes the requested app ID before sending this
+                // binding. Restore a minimized window belonging to that app,
+                // never an unrelated app chosen by global recency.
+                const home = ctx.env.get("HOME") orelse return;
+                const request_path = fmt.allocPrint(
+                    ctx.gpa,
+                    "{s}/.cache/neodots/restore-app-id",
+                    .{home},
+                ) catch return;
+                defer ctx.gpa.free(request_path);
+
+                const cwd = std.Io.Dir.cwd();
+                const request = cwd.readFileAlloc(
+                    ctx.io,
+                    request_path,
+                    ctx.gpa,
+                    .unlimited,
+                ) catch return;
+                defer ctx.gpa.free(request);
+                const requested_app_id = mem.trim(u8, request, " \\r\\n\\t");
+                if (requested_app_id.len == 0) return;
+
+                var it = ctx.windows.safeIterator(.forward);
+                while (it.next()) |window| {
+                    if (!window.minimized) continue;
+                    const app_id = window.app_id orelse continue;
+                    if (!mem.eql(u8, app_id, requested_app_id)) continue;
+                    window.restore_minimized();
+                    ctx.focus(window, true);
+                    break;
+                }
+            },
+            .raise_focused_window => {
+                if (ctx.focused_window()) |window| {
+                    window.restore_minimized();
